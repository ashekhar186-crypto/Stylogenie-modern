generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(MEMBER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items          Item[]
  tripPlans      TripPlan[]
  outfitFeedback OutfitFeedback[]
  outfitCalendar OutfitCalendar[]
}

enum Section {
  Tops
  Bottoms
  Dresses
  Outerwear
  Footwear
  Accessories
  Ethnicwear
  Sportswear
}

enum Season {
  Spring
  Summer
  Autumn
  Winter
}

enum Occasion {
  Casual
  Formal
  Sports
  Party
  Ethnic
}

model Item {
  id                String    @id @default(cuid())
  ownerId           String
  owner             User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  imageUrl          String
  title             String?
  brand             String?
  color             String[]  @default([])
  material          String?
  size              String?
  price             Decimal?  @db.Decimal(10, 2)

  season            Season?
  occasion          Occasion?
  styleTags         String[]  @default([])
  notes             String?
  section           Section?

  predictedLabels   String[]  @default([])
  confidences       Float[]   @default([])
  dominantColorHex  String?
  approved          Boolean   @default(false)
  archived          Boolean   @default(false)
  searchText        String?

  // Deep classification fields (v2)
  texture           String?
  pattern           String?
  fit               String?
  silhouette        String?
  styleEra          String?
  careGuess         String?
  deepSummary       String?

  // 2025 Micro-trend intelligence (from CLIP classifier)
  microTrend        String?   // e.g. "Quiet Luxury", "Ballet Core", "Dark Feminine"
  trendiness        Float?    // 0.0 – 1.0 trendiness score for 2025

  // Wear tracking & laundry (Features 6, 7)
  inLaundry         Boolean   @default(false)
  wearCount         Int       @default(0)
  lastWorn          DateTime?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([ownerId, createdAt(sort: Desc)])
}

// Feature 1: Outfit Memory & Learning — persisted like/dislike per outfit suggestion
model OutfitFeedback {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  outfitHash  String   // SHA-256 of item IDs sorted — deterministic per outfit combo
  reaction    String   // "like" | "dislike" | "save"
  outfitType  String?  // Western | Ethnic | Sport | Fusion
  occasion    String?
  itemIds     String[] @default([])
  notes       String?

  createdAt   DateTime @default(now())

  @@unique([userId, outfitHash])
  @@index([userId, reaction])
}

// Feature 5: Outfit Calendar — plan outfits by date
model OutfitCalendar {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date        String   // ISO date "YYYY-MM-DD"
  outfitLabel String?  // e.g. "Office Monday Look"
  itemIds     String[] @default([])
  outfitType  String?
  occasion    String?
  notes       String?
  imageUrl    String?  // optional snapshot

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model TripPlan {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  destination    String
  startDate      String?
  endDate        String?
  bagType        String?
  bagSize        String?
  bagNotes       String?

  weatherSummary String?
  packingList    Json?
  dailyOutfits   Json?
  styleNotes     String?
  avoidItems     String[]  @default([])
  bookingLinks   Json?

  // Feature 14: Packing checklist — track which items have been packed
  checkedItems   String[]  @default([])

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, createdAt(sort: Desc)])
}
